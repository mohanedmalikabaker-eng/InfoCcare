@model InfoCcare.Models.ViewModels.UserActivityLog

<h2>User Activity Log</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">User Email</label>
        <input name="email" value="@Model.Email" class="form-control" placeholder="search by email" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Entity</label>
        <input name="entity" value="@Model.Entity" class="form-control" placeholder="search by entity" />
    </div>

    <div class="col-md-2">
        <label class="form-label">From</label>
        <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">To</label>
        <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Page Size</label>
        <select class="form-select" name="pageSize">
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="20" selected="@(Model.PageSize == 20)">20</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
    </div>

    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>


<div class="mb-2">
    <b>Total Results:</b> @Model.TotalCount
    <span class="ms-3"><b>Page:</b> @Model.Page / @Model.TotalPages</span>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>User Email</th>
            <th>Entity</th>
            <th>Action</th>
            <th>Changes</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Logs.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center">No results</td>
            </tr>
        }
        else
        {
            foreach (var log in Model.Logs)
            {
                var shortChanges = string.IsNullOrEmpty(log.Changes)
                ? ""
                : (log.Changes.Length > 80 ? log.Changes.Substring(0, 80) + "..." : log.Changes);

                <tr>
                    <td>@log.TimesTamp.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@log.UserEmail</td>
                    <td>@log.EntityName</td>
                    <td>@log.Action</td>
                    <td title="@log.Changes">@shortChanges</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Details"
                           asp-route-id="@log.Id">
                            Details
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@{
    bool hasPrev = Model.Page > 1;
    bool hasNext = Model.Page < Model.TotalPages;

    // عشان نخلي كل الروابط حافظه للفلاتر الحالية
    object route(int p) => new
    {
        email = Model.Email,
        from = Model.From?.ToString("yyyy-MM-dd"),
        to = Model.To?.ToString("yyyy-MM-dd"),
        page = p,
        pageSize = Model.PageSize
    };
}

<nav>
    <ul class="pagination">
        <li class="page-item @(hasPrev ? "" : "disabled")">
            <a class="page-link" href="@Url.Action("Index", route(Model.Page - 1))">Prev</a>
        </li>

        <li class="page-item disabled">
            <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
        </li>

        <li class="page-item @(hasNext ? "" : "disabled")">
            <a class="page-link" href="@Url.Action("Index", route(Model.Page + 1))">Next</a>
        </li>
    </ul>
</nav>
