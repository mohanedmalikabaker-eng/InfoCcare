@model InfoCcare.Models.TaktikB2BPrepaidOfferViewModel

@{
    Layout = "_GradientLayout";

    var flex = Model.Offers.Where(o => o.FlexType == "FLEX");
    var Extras = Model.Offers.Where(o => o.FlexType == "Extras");
}

@section Styles {
    <link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
}

<div class="container mt-4">

    <ul class="nav nav-tabs justify-content-center" id="taktikTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="flex-tab" data-bs-toggle="tab" data-bs-target="#flex"
                    type="button" role="tab">
                📦 تك تك
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="Extras-tab" data-bs-toggle="tab" data-bs-target="#Extras"
                    type="button" role="tab">
                ⭐ الباقات الاضافية 
            </button>

        </li>
    </ul>

    <div class="tab-content mt-3" id="taktikTabsContent">

        <!-- FLEX -->
        <div class="tab-pane fade show active" id="flex" role="tabpanel">
            <div class="custom-table-container">
                <div class="align-items-md-center">
                    <h4 style="text-align:center">"" عروض باقات تك تك – TakTik Offers""</h4>
                </div>

                <table class="custom-table" dir="rtl">
                    <thead>
                        <tr>
                            <th>الباقة</th>
                            <th>الانترنت</th>
                            <th>الوحدات</th>
                            <th>السعر (بدون الضريبة)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in flex)
                        {
                            <tr>
                                <td>@item.Bundile</td>
                                <td>@item.Internet</td>
                                <td>@item.Units</td>
                                <td>@item.PriceVatExluded.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Extras -->
        <div class="tab-pane fade" id="Extras" role="tabpanel">
            <div class="custom-table-container">
                <div class="align-items-md-center">
                    <h4 style="text-align:center">""باقات الانترنت الاضافية – Extras Internet""</h4>
                </div>

                <table class="custom-table" dir="rtl">
                    <thead>
                        <tr>
                            <th>الباقة</th>
                            <th>السعر (بدون الضريبة)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Extras)
                        {
                            <tr>
                                <td>@item.Bundile</td>
                                <td>@item.PriceVatExluded.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <hr class="my-5" />

    <div dir="rtl" class="custom-table-container">
        <h4 style="text-align:right">الخصائص</h4>

        @if (Model.Descriptions != null && Model.Descriptions.Any())
        {
            @foreach (var desc in Model.Descriptions)
            {
                <div class="feature-box">
                    <h5>@desc.Title</h5>
                    <p>@Html.Raw(desc.Details)</p>
                </div>
            }
        }
        else
        {
            <p>لا توجد شروحات متاحة حالياً.</p>
        }
    </div>

</div>
