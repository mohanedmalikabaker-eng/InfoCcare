@model InfoCcare.Models.Tariff

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Tariff</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="CallSms" class="control-label"></label>
                <input asp-for="CallSms" class="form-control" />
                <span asp-validation-for="CallSms" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PriceVat" class="control-label"></label>
                <input asp-for="PriceVat" class="form-control" />
                <span asp-validation-for="PriceVat" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PriceNoVat" class="control-label"></label>
                <input asp-for="PriceNoVat" class="form-control" />
                <span asp-validation-for="PriceNoVat" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SegmentId" class="control-label"></label>
                <select asp-for="SegmentId" class="form-control" asp-items="ViewBag.SegmentId"></select>
                <span asp-validation-for="SegmentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
