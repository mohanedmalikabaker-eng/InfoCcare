@model InfoCcare.Models.PostpaidOfferViewModel

@{
    var voiceBundles = Model.Offers.Where(o => o.OffierType == "Voice bundles");
    var internetBundles = Model.Offers.Where(o => o.OffierType == "Internet bundles");
    var internetBundlesPerDay = Model.Offers.Where(o => o.OffierType == "Internet bundles Per Day");
    var InternetBundlesExtras = Model.Offers.Where(o => o.OffierType == "Internet bundles Extras");
}

@{
    Layout = "_GradientLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
}

<div class="container mt-4">

    <ul class="nav nav-tabs justify-content-center" id="postpaidTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="voice-tab" data-bs-toggle="tab" data-bs-target="#voice" type="button" role="tab">
                📞 عروض المكالمات
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="internet-tab" data-bs-toggle="tab" data-bs-target="#internet" type="button" role="tab">
                🌐 عروض الإنترنت
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="internetPerDay-tab" data-bs-toggle="tab" data-bs-target="#internetPerDay" type="button" role="tab">
                🌐 عروض الانترنت باليوم
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="InternetbundlesExtras-tab" data-bs-toggle="tab" data-bs-target="#InternetbundlesExtras" type="button" role="tab">
                🌐باقات الانترنت الاضافية
            </button>
        </li>
    </ul>

    <div class="tab-content mt-3" id="postpaidTabsContent">

        <!-- Voice Bundles -->
        <div class="tab-pane fade show active" id="voice" role="tabpanel">
            <div class="custom-table-container">
                <div class="align-items-md-center">
                    <h4 style="text-align:center">""عروض باقـات المكالمات – Call Package Offers""</h4>
                </div>

                <table class="custom-table" dir="rtl">
                    <thead>
                        <tr>
                            <th>الباقة</th>
                            <th>الدقائق</th>
                            <th>الرسائل</th>
                            <th>السعر (غير شامل الضريبة)</th>
                            <th>الرمز</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in voiceBundles)
                        {
                            <tr>
                                <td>@item.Package</td>
                                <td>@decimal.Parse(item.Bouns).ToString("N0")</td>
                                <td>@decimal.Parse(item.Mbs).ToString("N0")</td>
                                <td>@decimal.Parse(item.PriceNoVat).ToString("N0")</td>
                                <td>@item.Code</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Internet Bundles -->
        <div class="tab-pane fade" id="internet" role="tabpanel">
            <div class="custom-table-container">
                <div class="align-items-md-center">
                    <h4 style="text-align:center">""عروض  باقـات الإنترنت – Internet Package Offers""</h4>
                </div>

                <table class="custom-table" dir="rtl">
                    <thead>
                        <tr>
                            <th>الباقة</th>
                            <th>Bouns</th>
                            <th>Mbs</th>
                            <th>MbsBouns</th>
                            <th>السعر(غير شامل الضريبة)</th>
                            <th>Code</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in internetBundles)
                        {
                            <tr>
                                <td>@item.Package</td>
                                <td>@item.Bouns</td>
                                <td>@decimal.Parse(item.Mbs).ToString("N0")</td>
                                <td>@decimal.Parse(item.MbsBouns).ToString("N0")</td>
                                <td>@decimal.Parse(item.PriceNoVat).ToString("N0")</td>
                                <td>@item.Code</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Internet Bundles Per Day -->
        <div class="tab-pane fade" id="internetPerDay" role="tabpanel">
            <div class="custom-table-container">
                <div class="align-items-md-center">
                    <h4 style="text-align:center">""عروض الإنترنت اليومية – Internet Per Day Offers""</h4>
                </div>

                <table class="custom-table" dir="rtl">
                    <thead>
                        <tr>
                            <th>الباقة</th>
                            <th>Bouns</th>
                            <th>Mbs</th>
                            <th>MbsBouns</th>
                            <th>السعر(غير شامل الضريبة)</th>
                            <th>Code</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in internetBundlesPerDay)
                        {
                            <tr>
                                <td>@item.Package</td>
                                <td>@item.Bouns</td>
                                <td>@decimal.Parse(item.Mbs).ToString("N0")</td>
                                <td>@decimal.Parse(item.MbsBouns).ToString("N0")</td>
                                <td>@decimal.Parse(item.PriceNoVat).ToString("N0")</td>
                                <td>@item.Code</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Internet bundles Extras -->
        <div class="tab-pane fade" id="InternetbundlesExtras" role="tabpanel">
            <div class="custom-table-container">
                <div class="align-items-md-center">
                    <h4 style="text-align:center">""باقات الانترنت الاضافية – Internet bundles Extras""</h4>
                </div>

                <table class="custom-table" dir="rtl">
                    <thead>
                        <tr>
                            <th>الباقة</th>
                            <th>Mbs</th>
                            <th>السعر(غير شامل الضريبة)</th>
                            <th>Code</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in InternetBundlesExtras)
                        {
                            <tr>
                                <td>@item.Package</td>
                                <td>@decimal.Parse(item.Mbs).ToString("N0")</td>
                                <td>@decimal.Parse(item.PriceNoVat).ToString("N0")</td>
                                <td>@item.Code</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <hr class="my-5" />

    <div dir="rtl" class="custom-table-container">
        <h4 style="text-align:right">الخصائص</h4>

        @if (Model.Descriptions != null && Model.Descriptions.Any())
        {
            @foreach (var desc in Model.Descriptions)
            {
                <div class="feature-box">
                    <h5>@desc.Title</h5>
                    <p>@desc.Details</p>
                </div>
            }
        }
        else
        {
            <p>لا توجد شروحات متاحة حالياً.</p>
        }
    </div>

</div>
