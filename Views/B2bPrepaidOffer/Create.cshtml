@model InfoCcare.Models.B2bPrepaidOffer

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>B2bPrepaidOffer</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Package" class="control-label"></label>
                <input asp-for="Package" class="form-control" />
                <span asp-validation-for="Package" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PriceNoVat" class="control-label"></label>
                <input asp-for="PriceNoVat" class="form-control" />
                <span asp-validation-for="PriceNoVat" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Code" class="control-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OffierType" class="control-label"></label>
                <select asp-for="OffierType" class="form-control">
                    <option value="Voice bundles"> -- Select Offer --</option>
                    <option value="Voice bundles">Voice bundles</option>
                    <option value="Internet bundles">Internet bundles</option>
                    <option value="DC Daily Extra">DC Daily Extra</option>
                    <option value="Data Card">Data Card</option>
                    <option value="APN">APN</option>
                </select>
                <span asp-validation-for="OffierType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
