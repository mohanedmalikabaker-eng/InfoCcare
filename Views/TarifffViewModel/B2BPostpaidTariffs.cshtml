@model InfoCcare.Models.TarifView
@{
    Layout = "_GradientLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
}

<!-- جدول المكالمات -->
<div class="custom-table-container">
    <div class="align-items-md-center">
        <h4 style="text-align:center"> ""B2B Postpaid Call Tariff – تعرفة المكالمات اعمال الدفع الاجل""</h4>
    </div>
    <table class="custom-table" dir="rtl">
        <thead">
            <tr>
                <th>المكالمات</th>
                <th>السعر (غير شامل الضريبة)</th>
                <th>التعرفة بالضريبة</th>
            </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Call)
                {
                    <tr>
                        <td>@item.CallSms</td>
                        <td>@item.PriceNoVat.ToString("N3")</td>
                        <td>@item.PriceVat.ToString("N3")</td>
                    </tr>
                }
            </tbody>
    </table>
</div>
<!-- جدول الرسائل -->
<div class="custom-table-container">
    <div class="align-items-md-center">
        <h4 style="text-align:center"> ""B2B Postpaid SMS Tariff – تعرفة الرسائل النصية اعمال الدفع الاجل""</h4>
    </div>
    <table class="custom-table" dir="rtl">
        <thead>
            <tr>
                <th>الرسائل النصية</th>
                <th>السعر (غير شامل الضريبة)</th>
                <th>التعرفة بالضريبة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Sms)
            {
                <tr>
                    <td>@item.CallSms</td>
                    <td>@item.PriceNoVat.ToString("N3")</td>
                    <td>@item.PriceVat.ToString("N3")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<!-- CUG -->
<div class="custom-table-container">
    <div class="align-items-md-center">
        <h4 style="text-align:center"> "" CUG ""</h4>
    </div>
    <table class="custom-table" dir="rtl">
        <thead>
            <tr>
                <th>الرسائل النصية</th>
                <th>السعر (غير شامل الضريبة)</th>
                <th>التعرفة بالضريبة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Sms)
            {
                <tr>
                    <td>@item.CallSms</td>
                    <td>@item.PriceNoVat.ToString("N3")</td>
                    <td>@item.PriceVat.ToString("N3")</td>
                </tr>
            }
        </tbody>
    </table>
</div>