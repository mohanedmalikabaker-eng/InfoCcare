@model IEnumerable<InfoCcare.Models.PrePaid_Data>

@{
    ViewData["Title"] = "Index";
}

<h1>PrePaid Data Offer List</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New PrePaid Data Offer</a>
</p>
<table class="table  table table-bordered table-hover  d-xxl-table-row">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Package)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PriceNoVat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PriceVat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedOn)
            </th>
            <th>Detalis</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Package)
            </td>
            <td>
                    @item.PriceNoVat.ToString("N0")
            </td>
            <td>
                    @item.PriceVat.ToString("N0")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedOn)
            </td>
                <td>
                    <a class="btn btn-outline-info" asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
                <td>
                    <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                </td>
                <td>
                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
