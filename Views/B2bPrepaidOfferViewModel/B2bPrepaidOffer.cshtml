@model InfoCcare.Models.B2bPrepaidOfferViewModel

@{
    var voiceBundles = Model.Offers.Where(o => o.OffierType == "Voice bundles");
    var internetBundles = Model.Offers.Where(o => o.OffierType == "Internet bundles");
    var DCDailyExtra = Model.Offers.Where(o => o.OffierType == "DC Daily Extra");
}

@{
    Layout = "_GradientLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/table.css" asp-append-version="true" />
}

<div class="container mt-4">

    <ul class="nav nav-tabs justify-content-center" id="prepaidTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="voice-tab" data-bs-toggle="tab" data-bs-target="#voice" type="button" role="tab">
                📞 عروض المكالمات
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="internet-tab" data-bs-toggle="tab" data-bs-target="#internet" type="button" role="tab">
                🌐 عروض الإنترنت
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="DailyExtra-tab" data-bs-toggle="tab" data-bs-target="#DailyExtra" type="button" role="tab">
                🌐 الباقات الاضافية اليومية
            </button>
        </li>
    </ul>

    <div class="tab-content mt-3" id="prepaidTabsContent">

        <!-- Voice Bundles -->
        <div class="tab-pane fade show active" id="voice" role="tabpanel">
            <div class="custom-table-container">
                <div class="align-items-md-center">
                    <h4 style="text-align:center">""عروض باقـات المكالمات – Call Package Offers""</h4>
                </div>

                <table class="custom-table" dir="rtl">
                    <thead>
                        <tr>
                            <th>الباقة</th>
                            <th>السعر (غير شامل الضريبة)</th>
                            <th>الرمز</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in voiceBundles)
                        {
                            <tr>
                                <td>@item.Package</td>
                                <td>@item.PriceNoVat.ToString("N0")</td>
                                <td>@item.Code</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Internet Bundles -->
        <div class="tab-pane fade" id="internet" role="tabpanel">
            <div class="custom-table-container">
                <div class="align-items-md-center">
                    <h4 style="text-align:center">""عروض  باقـات الإنترنت – Internet Package Offers""</h4>
                </div>

                <table class="custom-table" dir="rtl">
                    <thead>
                        <tr>
                            <th>الباقة</th>
                            <th>السعر (غير شامل الضريبة)</th>
                            <th>الرمز</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in internetBundles)
                        {
                            <tr>
                                <td>@item.Package</td>
                                <td>@item.PriceNoVat.ToString("N0")</td>
                                <td>@item.Code</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- DC Daily Extra -->
        <div class="tab-pane fade" id="DailyExtra" role="tabpanel">
            <div class="custom-table-container">
                <div class="align-items-md-center">
                    <h4 style="text-align:center">""الباقات الاضافية اليومية – DC Daily Extra""</h4>
                </div>

                <table class="custom-table" dir="rtl">
                    <thead>
                        <tr>
                            <th>الباقة</th>
                            <th>السعر (غير شامل الضريبة)</th>
                            <th>الرمز</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in DCDailyExtra)
                        {
                            <tr>
                                <td>@item.Package</td>
                                <td>@item.PriceNoVat.ToString("N0")</td>
                                <td>@item.Code</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <hr class="my-5" />

    <!-- Features (اختياري) -->
    <div dir="rtl" class="custom-table-container">
        <h4 style="text-align:right">الخصائص</h4>

        @if (Model.Descriptions != null && Model.Descriptions.Any())
        {
            @foreach (var desc in Model.Descriptions)
            {
                <div class="feature-box">
                    <h5>@desc.Title</h5>
                    <p>@desc.Details</p>
                </div>
            }
        }
        else
        {
            <p>لا توجد شروحات متاحة حالياً.</p>
        }
    </div>

</div>
