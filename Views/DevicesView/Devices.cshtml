@model IEnumerable<InfoCcare.Models.Device>

@{
    Layout = "_GradientLayout";

    var wifiGroups = Model
        .Where(d => d.DeviceType == "WI-FI")
        .GroupBy(d => d.Model)
        .ToList();

    var mifiGroups = Model
        .Where(d => d.DeviceType == "MI-FI")
        .GroupBy(d => d.Model)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/devices-view.css" asp-append-version="true" />
}

<div class="container mt-4 devices-page" dir="ltr">

    <!-- Tabs -->
    <ul class="nav nav-tabs justify-content-center mb-4" id="deviceTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#wifi" type="button">
           Wi - Fi
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#mifi" type="button">
                 Mi - Fi
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- ================= WI-FI ================= -->
        <div class="tab-pane fade show active" id="wifi">
            <h4 class="section-title text-center mb-3">قائمة الواي فاي – Wi-Fi </h4>

            <div class="custom-table-container">
                <div class="custom-table-inner">
                    <table class="devices-table" dir="ltr">
                        <thead>
                            <tr>
                                <th class="col-img">Img</th>
                                <th class="col-type">Device Type</th>
                                <th class="col-model">Model</th>
                                <th>Bundle</th>
                                <th class="col-price">Price With Vat</th>
                                <th>Descrption</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in wifiGroups)
                            {
                                var rows = g.OrderBy(x => x.Bundle).ToList();
                                var first = rows.FirstOrDefault(x => !string.IsNullOrEmpty(x.Img))
                                ?? rows.First();
                                var rowspan = rows.Count;

                                for (int i = 0; i < rows.Count; i++)
                                {
                                    <tr>
                                        @if (i == 0)
                                        {
                                            <td rowspan="@rowspan">
                                                @if (!string.IsNullOrEmpty(first.Img))
                                                {
                                                    <img src="@first.Img" class="device-img" />
                                                }
                                                else
                                                {
                                                    <span class="dash">—</span>
                                                }
                                            </td>
                                            <td rowspan="@rowspan">@first.DeviceType</td>
                                            <td rowspan="@rowspan">@first.Model</td>
                                        }

                                        <td>@rows[i].Bundle</td>
                                        <td class="price">@rows[i].EndPrice.ToString("N3")</td>
                                        <td>@(string.IsNullOrWhiteSpace(rows[i].Desc) ? "—" : rows[i].Desc)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================= MI-FI ================= -->
        <div class="tab-pane fade" id="mifi">
            <h4 class="section-title text-center mb-3">قائمة الماي فاي – Mi-Fi </h4>

            <div class="custom-table-container">
                <div class="custom-table-inner">
                    <table class="devices-table" dir="ltr">
                        <thead>
                            <tr>
                                <th class="col-img">Img</th>
                                <th class="col-type">Device Type</th>
                                <th class="col-model">Model</th>
                                <th>Bundle</th>
                                <th class="col-price">Price With Vat</th>
                                <th>Descrption</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in mifiGroups)
                            {
                                var rows = g.OrderBy(x => x.Bundle).ToList();
                                var first = rows.FirstOrDefault(x => !string.IsNullOrEmpty(x.Img))
                                ?? rows.First();
                                var rowspan = rows.Count;

                                for (int i = 0; i < rows.Count; i++)
                                {
                                    <tr>
                                        @if (i == 0)
                                        {
                                            <td rowspan="@rowspan">
                                                @if (!string.IsNullOrEmpty(first.Img))
                                                {
                                                    <img src="@first.Img" class="device-img" />
                                                }
                                                else
                                                {
                                                    <span class="dash">—</span>
                                                }
                                            </td>
                                            <td rowspan="@rowspan">@first.DeviceType</td>
                                            <td rowspan="@rowspan">@first.Model</td>
                                        }

                                        <td>@rows[i].Bundle</td>
                                        <td class="price">
                                            @rows[i].EndPrice.ToString("N3")
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(rows[i].Desc) ? "—" : rows[i].Desc)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
